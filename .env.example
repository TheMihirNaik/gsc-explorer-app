# Google OAuth client for the Search Console integration.
# Create the client in Google Cloud Console -> APIs & Services -> Credentials.
# Never commit the real values; set them in your deployment platform.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PROJECT_ID=

# Optional: path to a local client_secrets.json used as a development
# fallback when the variables above are unset. The file is gitignored.
# GOOGLE_CLIENT_SECRETS_FILE=client_secrets.json
