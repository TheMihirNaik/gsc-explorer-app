# Where the SQLite file lives. IMPORTANT: on a host with an ephemeral
# filesystem (Heroku, Render's free tier, most container platforms) the default
# path is wiped on every deploy and restart. Point this at a mounted volume, or
# move to Postgres, before it holds anything you would miss.
DATABASE_PATH=data/gsc_explorer.db

# Encrypts OAuth refresh tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is derived from SECRET_KEY -- which means rotating SECRET_KEY
# forces everyone to reconnect their Google account.
TOKEN_ENCRYPTION_KEY=

# Flask session signing key. Required -- the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Redis, used as the Celery broker/result backend and as server-side session
# storage. Without it, OAuth credentials fall back to the client cookie.
REDIS_URL=redis://localhost:6379/0

# Google OAuth client for the Search Console integration.
# Create the client in Google Cloud Console -> APIs & Services -> Credentials.
# Never commit the real values; set them in your deployment platform.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PROJECT_ID=

# Optional: path to a local client_secrets.json used as a development
# fallback when the variables above are unset. The file is gitignored.
# GOOGLE_CLIENT_SECRETS_FILE=client_secrets.json
